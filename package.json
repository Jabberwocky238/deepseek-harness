{
  "name": "@jabberwocky238/cordis",
  "description": "Cordis: a plugin framework built on context, effects, and fiber lifecycle",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jabberwocky238/deepseek-harness.git"
  },
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./timer": {
      "types": "./lib/types/plugins/timer.d.ts",
      "default": "./lib/plugins/timer.js"
    },
    "./hmr": {
      "types": "./lib/types/plugins/hmr/index.d.ts",
      "default": "./lib/plugins/hmr/index.js"
    },
    "./group": {
      "types": "./lib/types/plugins/group.d.ts",
      "default": "./lib/plugins/group.js"
    },
    "./include": {
      "types": "./lib/types/plugins/include.d.ts",
      "default": "./lib/plugins/include.js"
    },
    "./logger-console": {
      "types": "./lib/types/plugins/logger-console/index.d.ts",
      "default": "./lib/plugins/logger-console/index.js"
    },
    "./package.json": "./package.json",
    "./loader": {
      "types": "./lib/types/loader/index.d.ts",
      "default": "./lib/loader/index.js"
    }
  },
  "files": [
    "lib",
    "src"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@babel/code-frame": "^7.29.0",
    "@standard-schema/spec": "^1.1.0",
    "chokidar": "^4.0.3",
    "js-yaml": "^4.1.0",
    "picomatch": "^4.0.3",
    "supports-color": "^9.4.0"
  },
  "peerDependencies": {
    "node-addon-require-builtin": "^0.1.4"
  },
  "peerDependenciesMeta": {
    "node-addon-require-builtin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf lib",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "verify:consumer": "pnpm pack --pack-destination /tmp && bash scripts/verify-consumer.sh /tmp"
  }
}
