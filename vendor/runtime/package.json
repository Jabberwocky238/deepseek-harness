{
  "name": "@deepseek-ai/cordis-runtime",
  "description": "Aggregate entry point: re-exports the Cordis framework and starts an application from a config file",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/lib.js",
  "types": "lib/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/lib.d.ts",
      "default": "./lib/lib.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/lib.js",
    "lib/types/**/*.d.ts",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  }
}
